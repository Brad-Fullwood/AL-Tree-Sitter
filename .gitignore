# ============================================================
# GENERATED SOURCES (COMMITTED)
# ============================================================
# These files are generated by `cargo run --release`, but are intentionally
# committed so other tools (e.g. Zed) can consume the grammar repo without
# needing to run the generator.
#
# - grammar.js
# - src/parser.c
# - src/scanner.c
# - src/keywords.c
# - src/grammar.json
# - queries/*.scm

# ============================================================
# BUILD ARTIFACTS
# ============================================================

# Rust build
target/

# Tree-sitter bindings
build/
prebuilds/
*.node
*.a
*.so
*.dylib
*.dll

# Test repositories (cloned for validation)
tests/.repos/

# Third-party cloned repos / fixtures
third_party/

# Tree-sitter test snapshots (varies by tooling)
.snapshots/
**/.snapshots/

# We do not ship tree-sitter corpus tests in this repo.
test/

