{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "al",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_item"
      }
    },
    "_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "object_declaration"
        },
        {
          "type": "SYMBOL",
          "name": "braced_block"
        },
        {
          "type": "SYMBOL",
          "name": "parenthesized_block"
        },
        {
          "type": "SYMBOL",
          "name": "bracketed_block"
        },
        {
          "type": "SYMBOL",
          "name": "_atom"
        }
      ]
    },
    "object_declaration": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "kind",
            "content": {
              "type": "SYMBOL",
              "name": "object_keyword"
            }
          },
          {
            "type": "FIELD",
            "name": "id",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "integer"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          },
          {
            "type": "FIELD",
            "name": "name",
            "content": {
              "type": "SYMBOL",
              "name": "name"
            }
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_pre_object_body"
            }
          },
          {
            "type": "FIELD",
            "name": "body",
            "content": {
              "type": "SYMBOL",
              "name": "braced_block"
            }
          }
        ]
      }
    },
    "object_modifier": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "modifier",
          "content": {
            "type": "SYMBOL",
            "name": "metadata_keyword"
          }
        },
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "name"
          }
        }
      ]
    },
    "_pre_object_body": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "object_modifier"
        },
        {
          "type": "SYMBOL",
          "name": "directive"
        },
        {
          "type": "SYMBOL",
          "name": "parenthesized_block"
        },
        {
          "type": "SYMBOL",
          "name": "bracketed_block"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "verbatim_string"
        },
        {
          "type": "SYMBOL",
          "name": "quoted_identifier"
        },
        {
          "type": "SYMBOL",
          "name": "integer"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "control_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "object_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "type_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "property_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "punctuation"
        }
      ]
    },
    "braced_block": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "{"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "braced_block"
                },
                {
                  "type": "SYMBOL",
                  "name": "parenthesized_block"
                },
                {
                  "type": "SYMBOL",
                  "name": "bracketed_block"
                },
                {
                  "type": "SYMBOL",
                  "name": "_atom"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "}"
          }
        ]
      }
    },
    "parenthesized_block": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "("
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "braced_block"
                },
                {
                  "type": "SYMBOL",
                  "name": "parenthesized_block"
                },
                {
                  "type": "SYMBOL",
                  "name": "bracketed_block"
                },
                {
                  "type": "SYMBOL",
                  "name": "_atom"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": ")"
          }
        ]
      }
    },
    "bracketed_block": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "["
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "braced_block"
                },
                {
                  "type": "SYMBOL",
                  "name": "parenthesized_block"
                },
                {
                  "type": "SYMBOL",
                  "name": "bracketed_block"
                },
                {
                  "type": "SYMBOL",
                  "name": "_atom"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "]"
          }
        ]
      }
    },
    "name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "quoted_identifier"
        }
      ]
    },
    "_atom": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "verbatim_string"
        },
        {
          "type": "SYMBOL",
          "name": "quoted_identifier"
        },
        {
          "type": "SYMBOL",
          "name": "integer"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "control_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "object_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "type_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "metadata_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "property_keyword"
        },
        {
          "type": "SYMBOL",
          "name": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "punctuation"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_\\u0080-\\uFFFF][A-Za-z0-9_\\u0080-\\uFFFF]*"
    },
    "integer": {
      "type": "PATTERN",
      "value": "[0-9]+"
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "'"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^']"
                },
                {
                  "type": "STRING",
                  "value": "''"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "'"
          }
        ]
      }
    },
    "verbatim_string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "@'"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^']"
                },
                {
                  "type": "STRING",
                  "value": "''"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "'"
          }
        ]
      }
    },
    "quoted_identifier": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\"]"
                },
                {
                  "type": "STRING",
                  "value": "\"\""
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "directive": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": "[^\\n]*"
          }
        ]
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "//"
              },
              {
                "type": "PATTERN",
                "value": "[^\\n]*"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "/*"
              },
              {
                "type": "PATTERN",
                "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
              },
              {
                "type": "STRING",
                "value": "/"
              }
            ]
          }
        ]
      }
    },
    "operator": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[!$%&*+\\-./:<=>?@^|~]+"
      }
    },
    "punctuation": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": ";"
          },
          {
            "type": "STRING",
            "value": ","
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    },
    {
      "type": "SYMBOL",
      "name": "directive"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "keyword"
    },
    {
      "type": "SYMBOL",
      "name": "control_keyword"
    },
    {
      "type": "SYMBOL",
      "name": "object_keyword"
    },
    {
      "type": "SYMBOL",
      "name": "type_keyword"
    },
    {
      "type": "SYMBOL",
      "name": "metadata_keyword"
    },
    {
      "type": "SYMBOL",
      "name": "property_keyword"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}